SERVICE_NAME=crm
PORT=4101
LOG_LEVEL=info
LOG_FORMAT=json
ENVIRONMENT=production

JWT_ISSUER=https://auth.example.com
JWKS_URL=https://auth.example.com/.well-known/jwks.json
AUDIENCE=iag.crm
SERVICE_CLIENT_ID=iag-crm
SERVICE_CLIENT_SECRET=
# Optional dedicated key for OAuth token encryption (defaults to SERVICE_CLIENT_SECRET)
# INTEGRATION_TOKEN_SECRET=
AUTH_TOKEN_URL=https://auth.example.com/oauth/token

GATEWAY_API_PREFIX=/api/v1/crm
PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGINS=https://crm.example.com

DATABASE_URL=postgres://svc_iag_crm:CHANGE_ME@pgbouncer:6432/iag_platform?sslmode=require

AUTO_MIGRATE=true
SEED_ON_EMPTY=false

EVENT_BUS_ENABLED=true
KAFKA_BROKERS=kafka-broker-1:9092,kafka-broker-2:9092
