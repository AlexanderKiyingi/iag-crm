SERVICE_NAME=crm
PORT=4101
LOG_LEVEL=info
ENVIRONMENT=development
# LOG_FORMAT=json

# Hard cutover: every request must carry a Bearer JWT with aud=iag.crm.
# AUTH_MODE no longer exists.
JWT_ISSUER=http://localhost:3001
JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUDIENCE=iag.crm
SERVICE_CLIENT_ID=iag-crm
SERVICE_CLIENT_SECRET=dev-crm-secret-bootstrap
AUTH_TOKEN_URL=http://127.0.0.1:3001/oauth/token

GATEWAY_API_PREFIX=/api/v1/crm
PUBLIC_API_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgres://svc_iag_crm:iag_crm_dev@localhost:5432/iag_platform?sslmode=disable
AUTO_MIGRATE=true
SEED_ON_EMPTY=true
SERVE_UI=true

# Upstream services (resolved from PUBLIC_API_URL when unset)
# USERS_API_URL=http://localhost:8080/api/v1/users
# FINANCE_API_URL=http://localhost:8080/api/v1/finance
# DMS_API_URL=http://localhost:8080/api/v1/dms
# CONTRACTS_API_URL=http://localhost:8080/api/v1/contract-management

# Kafka domain events (iag.commercial)
# EVENT_BUS_ENABLED=true
# KAFKA_BROKERS=localhost:19092
# CONSUMER_ENABLED=true
# CONSUMER_GROUP_ID=iag.crm.commercial
# CONSUMER_DLQ_TOPIC=iag.dlq.crm

# Journey runner (processes due enrollments)
# JOURNEY_RUNNER_INTERVAL=30s

# OAuth tokens at rest (AES-GCM). Defaults to SERVICE_CLIENT_SECRET when unset.
# INTEGRATION_TOKEN_SECRET=

# Google / Microsoft OAuth for email + calendar sync (redirect defaults to PUBLIC_API_URL callback)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/crm/v1/integrations/oauth/google/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/crm/v1/integrations/oauth/microsoft/callback

# Optional bind override (PORT/HTTP_PORT take precedence over ADDR)
# ADDR=:4101

# Next.js: NEXT_PUBLIC_CRM_API_URL=http://localhost:8080/api/v1/crm/v1
