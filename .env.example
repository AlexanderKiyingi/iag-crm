SERVICE_NAME=crm
PORT=4101
LOG_LEVEL=info
ENVIRONMENT=development
AUTH_MODE=jwt

JWT_ISSUER=http://localhost:3001
JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUDIENCE=iag.crm
SERVICE_CLIENT_ID=iag-crm
SERVICE_CLIENT_SECRET=dev-crm-secret-bootstrap
AUTH_TOKEN_URL=http://127.0.0.1:3001/oauth/token

GATEWAY_API_PREFIX=/api/v1/crm
PUBLIC_API_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgres://svc_iag_crm:iag_crm_dev@localhost:5432/iag_platform?sslmode=disable
AUTO_MIGRATE=true
SEED_ON_EMPTY=true
SERVE_UI=true

# Kafka domain events (iag.commercial) — optional
# EVENT_BUS_ENABLED=true
# KAFKA_BROKERS=localhost:9092

# Next.js: NEXT_PUBLIC_CRM_API_URL=http://localhost:8080/api/v1/crm/v1

# Local open API (no JWT): AUTH_MODE=none
